set -eu

MARKSHUP_EXECUTABLE_PATH=$( CDPATH='' cd "$( dirname "$0" )" && pwd )
MARKSHUP_EXECUTABLE_PATH=$MARKSHUP_EXECUTABLE_PATH/$( basename "$0" )
export MARKSHUP_EXECUTABLE_PATH
MARKSHUP_SELFUPDATE_AVAILABLE=1
export MARKSHUP_SELFUPDATE_AVAILABLE

markshupTemporaryDirectory=$( mktemp -d \
"${TMPDIR:-/tmp}/markshup.XXXXXX" )
markshupReleaseTemporaryDirectory=$markshupTemporaryDirectory
MARKSHUP_DEFAULT_CSS_PATH=$markshupTemporaryDirectory
MARKSHUP_DEFAULT_CSS_PATH=$MARKSHUP_DEFAULT_CSS_PATH/default.css
MARKSHUP_RENDERER_PATH=$markshupTemporaryDirectory
MARKSHUP_RENDERER_PATH=$MARKSHUP_RENDERER_PATH/parser.awk
MARKSHUP_TEMPLATE_QUOTER_PATH=$markshupTemporaryDirectory
MARKSHUP_TEMPLATE_QUOTER_PATH=$MARKSHUP_TEMPLATE_QUOTER_PATH/template-quote.awk
MARKSHUP_MERMAID_HELPER_PATH=$markshupTemporaryDirectory
MARKSHUP_MERMAID_HELPER_PATH=$MARKSHUP_MERMAID_HELPER_PATH/mermaid-helper.js
MARKSHUP_MERMAID_LICENSE_PATH=$markshupTemporaryDirectory
MARKSHUP_MERMAID_LICENSE_PATH=$MARKSHUP_MERMAID_LICENSE_PATH/
MARKSHUP_MERMAID_LICENSE_PATH=${MARKSHUP_MERMAID_LICENSE_PATH}mermaid-
MARKSHUP_MERMAID_LICENSE_PATH=${MARKSHUP_MERMAID_LICENSE_PATH}license.txt
awk '
/^: <<\\__MARKSHUP_DEFAULT_CSS__$/ {
	found = 1
	next
}
/^__MARKSHUP_DEFAULT_CSS__$/ {
	exit
}
found {
	print
}
' "$0" > "$MARKSHUP_DEFAULT_CSS_PATH"
awk '
/^: <<\\__MARKSHUP_RENDERER__$/ {
	found = 1
	next
}
/^__MARKSHUP_RENDERER__$/ {
	exit
}
found {
	print
}
' "$0" > "$MARKSHUP_RENDERER_PATH"
awk '
/^: <<\\__MARKSHUP_TEMPLATE_QUOTER__$/ {
	found = 1
	next
}
/^__MARKSHUP_TEMPLATE_QUOTER__$/ {
	exit
}
found {
	print
}
' "$0" > "$MARKSHUP_TEMPLATE_QUOTER_PATH"
awk '
/^: <<\\__MARKSHUP_MERMAID_HELPER__$/ {
	found = 1
	next
}
/^__MARKSHUP_MERMAID_HELPER__$/ {
	exit
}
found {
	print
}
' "$0" > "$MARKSHUP_MERMAID_HELPER_PATH"
awk '
/^: <<\\__MARKSHUP_MERMAID_LICENSE__$/ {
	found = 1
	next
}
/^__MARKSHUP_MERMAID_LICENSE__$/ {
	exit
}
found {
	print
}
' "$0" > "$MARKSHUP_MERMAID_LICENSE_PATH"

