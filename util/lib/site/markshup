function protectInlineHtml( value, output, start, \
	token, tokenLength )
{
	output = ""
	while (match(value, /[<&]/)) {
		start = RSTART
		output = output substr(value, 1, start - 1)
		value = substr(value, start)
		tokenLength = 0
		if (value ~ /^<!--.*-->/) {
			match(value, /^<!--.*-->/)
			tokenLength = RLENGTH
		} else if (value ~ /^<\/?[[:alpha:]][^>]*>/) {
			match(value, /^<\/?[[:alpha:]][^>]*>/)
			tokenLength = RLENGTH
		} else if (value ~ \
			/^&([[:alpha:]][[:alnum:]]*|#[0-9]+|#[xX][0-9A-Fa-f]+);/) {
			match(value, /^&([[:alpha:]][[:alnum:]]*|#[0-9]+|#[xX][0-9A-Fa-f]+);/)
			tokenLength = RLENGTH
		}
		if (tokenLength == 0) {
			output = output substr(value, 1, 1)
			value = substr(value, 2)
			continue
		}
		token = "\035t" ++inlineHtmlTokenCount "\036"
		inlineHtmlTokens[inlineHtmlTokenCount] = substr(value, 1, tokenLength)
		output = output token
		value = substr(value, tokenLength + 1)
	}
	return output value
}


function restoreInlineHtml( \
	value, \
	token, \
	tokenIndex, \
	tokenStart, \
	tokenLength )
{
	while (match(value, /\035t[0-9]+\036/)) {
		tokenStart = RSTART
		tokenLength = RLENGTH
		token = substr(value, RSTART, RLENGTH)
		tokenIndex = token
		sub(/^\035t/, "", tokenIndex)
		sub(/\036$/, "", tokenIndex)
		value = substr(value, 1, tokenStart - 1) \
			rewriteHtmlReferences(inlineHtmlTokens[tokenIndex]) \
			substr(value, tokenStart + tokenLength)
	}
	return value
}


