#
# Copyright 2026 CodingMarkus
#
# SPDX-License-Identifier: AGPL-3.0-only
#
# cspell:words gsub tolower getline sprintf alnum
# cspell:words apng jfif svgz
# cspell:words SUBSEP RSTART RLENGTH
# cspell:words dppx cdata colgroup fieldset figaction basefont frameset
# cspell:words figcaption noframes optgroup tfoot
# cspell:words Outdir


function escapeHtml( value )
{
	gsub(/&/, "\\&amp;", value)
	gsub(/</, "\\&lt;", value)
	gsub(/>/, "\\&gt;", value)
	gsub(/"/, "\\&quot;", value)
	return value
}


function fileExtension( url, cleanUrl, extension )
{
	cleanUrl = url
	sub(/[?#].*$/, "", cleanUrl)
	extension = cleanUrl
	sub(/^.*\./, "", extension)
	return tolower(extension)
}


function supportsCommonExtensions( )
{
	return markdownStyle != "common"
}


function supportsLessCommonExtensions( )
{
	return markdownStyle == "extended" || markdownStyle == "markshup"
}


function supportsMarkshupExtensions( )
{
	return markdownStyle == "markshup"
}


function faviconMimeType( url, extension )
{
	extension = fileExtension(url)
	if (extension == "apng") return "image/apng"
	if (extension == "avif") return "image/avif"
	if (extension == "bmp") return "image/bmp"
	if (extension == "cur" || extension == "ico") return "image/x-icon"
	if (extension == "gif") return "image/gif"
	if (extension == "heic") return "image/heic"
	if (extension == "jfif" || extension == "jpeg" \
		|| extension == "jpg") return "image/jpeg"
	if (extension == "jxl") return "image/jxl"
	if (extension == "png") return "image/png"
	if (extension == "svg" || extension == "svgz") return "image/svg+xml"
	if (extension == "tif" || extension == "tiff") return "image/tiff"
	if (extension == "webp") return "image/webp"
	return ""
}


function loadImageBundles( line, fields )
{
	if (imageBundlePath == "") return
	while ((getline line < imageBundlePath) > 0) {
		split(line, fields, "\t")
		if (length(fields) == 6) {
			imageBundleRefs[fields[1]] = 1
			imageBundleAltPaths[fields[1]] = fields[2]
			imageBundleUrls[fields[1] SUBSEP fields[3] SUBSEP \
				fields[4] SUBSEP fields[5]] = normalizeAssetUrl(fields[6])
		}
	}
	close(imageBundlePath)
}


function imageBundleUrl( reference, color, extension, density )
{
	return imageBundleUrls[reference SUBSEP color SUBSEP extension \
		SUBSEP density]
}


function imageBundleAltText( reference, line, output, result )
{
	if (reference in imageBundleAltTexts) return imageBundleAltTexts[reference]
	while ((result = getline line < imageBundleAltPaths[reference]) > 0) {
		output = output (output == "" ? "" : " ") line
	}
	close(imageBundleAltPaths[reference])
	imageBundleHasAltTexts[reference] = result != -1
	imageBundleAltTexts[reference] = output
	return output
}


function imageBundleFallbackColor( reference, path )
{
	path = reference
	sub(/[?#].*$/, "", path)
	if (path ~ /\/image(@[23]x)?\.[^\/]+$/) return "image"
	if (path ~ /\/light(@[23]x)?\.[^\/]+$/) return "light"
	return "dark"
}


function imageBundleHasColor( reference, color, extensionIndex, density )
{
	for (extensionIndex = 1; extensionIndex <= 9; extensionIndex += 1) {
		extension = imageBundleFormatOrder[extensionIndex]
		for (density = 1; density <= 3; density += 1) {
			if (imageBundleUrl(reference, color, extension, density) != "") {
				return 1
			}
		}
	}
	return 0
}


function imageBundleFormatCount( reference, color, count, extensionIndex,
	density )
{
	count = 0
	for (extensionIndex = 1; extensionIndex <= 9; extensionIndex += 1) {
		for (density = 1; density <= 3; density += 1) {
			if (imageBundleUrl(reference, color,
				imageBundleFormatOrder[extensionIndex], density) != "") {
				count += 1
				break
			}
		}
	}
	return count
}


function formatImageBundleGroup( reference, color, media, formatCount,
	output, density, extensionIndex, extension, url )
{
	output = ""
	for (density = 3; density >= 1; density -= 1) {
		for (extensionIndex = 1; extensionIndex <= 9; extensionIndex += 1) {
			extension = imageBundleFormatOrder[extensionIndex]
			url = imageBundleUrl(reference, color, extension, density)
			if (url != "") {
				output = output "<source" \
					(media == "" && density == 1 ? "" : " media=\"" \
					media (media != "" && density > 1 ? " and " : "") \
					(density > 1 ? "(min-resolution: " density "dppx)" : "") \
					"\"") " srcset=\"" escapeHtml(url) "\"" \
					(formatCount > 1 ? " type=\"" \
					faviconMimeType("image." extension) "\"" : "") ">"
			}
		}
	}
	return output
}


function formatImageBundle( reference, fallbackColor, output, formatCount )
{
	output = "<picture>"
	if (imageBundleHasColor(reference, "light")) {
		formatCount = imageBundleFormatCount(reference, "light")
		output = output formatImageBundleGroup(reference, "light", \
			"(prefers-color-scheme: light)", formatCount)
	}
	if (imageBundleHasColor(reference, "dark")) {
		formatCount = imageBundleFormatCount(reference, "dark")
		output = output formatImageBundleGroup(reference, "dark", \
			"(prefers-color-scheme: dark)", formatCount)
	}
	fallbackColor = imageBundleFallbackColor(reference)
	formatCount = imageBundleFormatCount(reference, fallbackColor)
	return output formatImageBundleGroup(reference, fallbackColor, "", \
		formatCount)
}


function printFaviconLink( url, media, expandedUrl, \
	mimeType )
{
	expandedUrl = expandTemplateLink(url)
	mimeType = faviconMimeType(expandedUrl)
	print "<link rel=\"icon\" href=\"" escapeHtml(expandedUrl) "\"" \
		(mimeType == "" ? "" : " type=\"" mimeType "\"") \
		(media == "" ? "" : " media=\"" media "\"") ">"
}


function printStylesheetLink( url, expandedUrl )
{
	expandedUrl = expandTemplateLink(url)
	print "<link rel=\"stylesheet\" href=\"" escapeHtml(expandedUrl) "\">"
}


function printJavascriptLink( url, expandedUrl )
{
	expandedUrl = expandTemplateLink(url)
	print "<script src=\"" escapeHtml(expandedUrl) "\"></script>"
}


function printMetaTags( path, line, separator, \
	name, value )
{
	while ((getline line < path) > 0) {
		separator = index(line, "\t")
		if (separator == 0) continue
		name = substr(line, 1, separator - 1)
		value = substr(line, separator + 1)
		print "<meta name=\"" escapeHtml(decodeMeta(name)) \
			"\" content=\"" escapeHtml(decodeMeta(value)) "\">"
	}
	close(path)
}


function decodeMeta( value, characterIndex, character, escaped, result )
{
	result = ""
	for (characterIndex = 1; characterIndex <= length(value); characterIndex++) {
		character = substr(value, characterIndex, 1)
		if (character != "\\") {
			result = result character
			continue
		}
		if (++characterIndex > length(value)) return result
		escaped = substr(value, characterIndex, 1)
		if (escaped == "n") result = result "\n"
		else if (escaped == "r") result = result "\r"
		else if (escaped == "t") result = result "\t"
		else result = result escaped
	}
	return result
}


function emitFile( path, line )
{
	while ((getline line < path) > 0) {
		print line
	}
	close(path)
}


function normalizePath( path, pathParts, partCount, \
	partIndex, result )
{
	partCount = split(path, pathParts, "/")
	result = ""
	for (partIndex = 1; partIndex <= partCount; partIndex += 1) {
		if (pathParts[partIndex] == "" || pathParts[partIndex] == ".") {
			continue
		}
		if (pathParts[partIndex] == "..") {
			sub(/\/[^\/]+$/, "", result)
			continue
		}
		result = result "/" pathParts[partIndex]
	}
	return result == "" ? "/" : result
}


function relativePath( \
	from, \
	to, \
	fromParts, \
	toParts, \
	fromCount, \
	toCount, \
	common, \
	partIndex, \
	result  )
{
	fromCount = split(from, fromParts, "/")
	toCount = split(to, toParts, "/")
	common = 1
	while (common <= fromCount && common <= toCount \
		&& fromParts[common] == toParts[common]) {
		common += 1
	}
	result = ""
	for (partIndex = common; partIndex <= fromCount; partIndex += 1) {
		if (fromParts[partIndex] != "") {
			result = result "../"
		}
	}
	for (partIndex = common; partIndex <= toCount; partIndex += 1) {
		if (toParts[partIndex] != "") {
			result = result toParts[partIndex] "/"
		}
	}
	sub(/\/$/, "", result)
	return result == "" ? "." : result
}


function expandOutdirReferences( \
	line, \
	reference, \
	referenceStart, \
	referenceLength, \
	target, \
	suffixIndex, \
	pathSuffix, \
	urlSuffix, \
	replacement  )
{
	while (match(line, /\$\{OUTDIR\}[^[:space:]"'<>]*/)) {
		referenceStart = RSTART
		referenceLength = RLENGTH
		reference = substr(line, RSTART, RLENGTH)
		pathSuffix = substr(reference, length("${OUTDIR}") + 1)
		suffixIndex = match(pathSuffix, /[?#]/)
		urlSuffix = ""
		if (suffixIndex != 0) {
			urlSuffix = substr(pathSuffix, suffixIndex)
			pathSuffix = substr(pathSuffix, 1, suffixIndex - 1)
		}
		target = normalizePath(outputDirectory pathSuffix)
		replacement = relativePath(documentDirectory, target) urlSuffix
		line = substr(line, 1, referenceStart - 1) replacement \
			substr(line, referenceStart + referenceLength)
	}
	return line
}


function emitTemplateFile( path, line )
{
	while ((getline line < path) > 0) {
		print expandOutdirReferences(line)
	}
	close(path)
}


function expandTemplateLink( link )
{
	if (index(link, templateLinkMarker) == 1) {
		return expandOutdirReferences( \
			substr(link, length(templateLinkMarker) + 1))
	}
	return link
}


function rewriteUrl( url )
{
	if (url ~ /^https?:\/\//) {
		return stripConfiguredFragment(url)
	}
	if (url ~ /^[A-Za-z][A-Za-z0-9+.-]*:/ || url ~ /^\/\// || url ~ /^#/) {
		return url
	}
	if (url ~ /\.md([?#].*)?$/) {
		url = normalizeMarkdownUrl(url)
	} else if (url !~ /^\//) {
		url = normalizeAssetUrl(url)
	}
	return url
}


function stripConfiguredFragment( url, fragmentStart )
{
	if (stripFragmentValue == "") {
		return url
	}
