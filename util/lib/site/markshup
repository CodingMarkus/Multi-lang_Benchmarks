# $1 - Template metadata list path.
markshupApplyTemplateMeta( )
{
	[ -f "$1" ] || return 0
	_matm_entries=
	markshupTemplateMarker "$1"
	case $_mtm_marker in
		'--')
			_matm_entries=$_mst_metaFallbackEntries
			_matm_inheritsFallback=1
			;;
		+)
			_matm_entries=$_mst_metaEntries
			_matm_inheritsFallback=$_mst_metaInheritsFallback
			;;
		--+)
			_matm_entries=$_mst_metaEntries
			_matm_inheritsFallback=$_mst_metaInheritsFallback
			if [ "$_matm_inheritsFallback" -eq 0 ]
			then
				_matm_entries=$( markshupAppendLine \
					"$_mst_metaFallbackEntries" "$_matm_entries" )
				_matm_inheritsFallback=1
			fi
			;;
		*) _matm_inheritsFallback=0 ;;
	esac
	if ! _matm_templateEntries=$( awk -v marker="$_mtm_marker" \
		-f "$MARKSHUP_TEMPLATE_QUOTER_PATH" -f - "$1" <<'EOF'
		BEGIN {
			first = 1
		}
		function fail( ) {
			exit 1
		}
		{
			line = $0
			trimmed = line
			gsub(/^[[:space:]]*|[[:space:]]*$/, "", trimmed)
			if (trimmed == "" || trimmed ~ /^#/) next
			if (first && marker != "") {
				first = 0
				next
			}
			first = 0
			start = 1
			while (substr(line, start, 1) ~ /[ \t]/) start++
			if (substr(line, start, 1) == "\"") {
				templateParseQuoted(line, start)
				name = templateParsed
				while (substr(line, templatePosition, 1) ~ /[ \t]/) \
					templatePosition++
				if (substr(line, templatePosition++, 1) != ":") fail()
				position = templatePosition
			} else {
				separator = index(substr(line, start), ":")
				if (separator == 0) fail()
				separator += start - 1
				end = separator - 1
				while (substr(line, end, 1) ~ /[ \t]/) end--
				if (end < start) fail()
				templateParseUnquoted(line, start, end)
				name = templateParsed
				position = separator + 1
			}
			while (substr(line, position, 1) ~ /[ \t]/) position++
			if (substr(line, position, 1) == "\"") {
				templateParseQuoted(line, position)
				value = templateParsed
				while (substr(line, templatePosition, 1) ~ /[ \t]/) \
					templatePosition++
				if (templatePosition <= length(line)) fail()
			} else {
				end = length(line)
				while (substr(line, end, 1) ~ /[ \t]/) end--
				templateParseUnquoted(line, position, end)
				value = templateParsed
			}
			print templateEncode(name) "\t" templateEncode(value)
		}
EOF
	)
	then
		markshupFail "Invalid metadata entry in $1"
	fi
	if [ -n "$_matm_templateEntries" ]
	then
		_matm_entries=$( markshupAppendLine \
			"$_matm_entries" "$_matm_templateEntries" )
	fi
	_mst_metaEntries=$_matm_entries
	_mst_metaInheritsFallback=$_matm_inheritsFallback
}


# $1 - Template asset list path.
# $2 - Asset type: stylesheet, favicon, favicon-light, favicon-dark, or
# javascript.
markshupApplyTemplateLinks( )
{
	[ -f "$1" ] || return 0
	_matl_urls=
	_matl_firstLine=1
	markshupTemplateMarker "$1"
	case $_mtm_marker in
		'--')
			_matl_urls=$( markshupTemplateFallbackUrls "$2" )
			_matl_inheritsFallback=1
			;;
		+)
			_matl_urls=$( markshupTemplateUrls "$2" )
			_matl_inheritsFallback=$( markshupTemplateInheritsFallback "$2" )
			;;
		--+)
			_matl_urls=$( markshupTemplateUrls "$2" )
			_matl_inheritsFallback=$( markshupTemplateInheritsFallback "$2" )
			if [ "$_matl_inheritsFallback" -eq 0 ]
			then
				_matl_urls=$( markshupAppendValues \
					"$( markshupTemplateFallbackUrls "$2" )" \
					"$_matl_urls" )
				_matl_inheritsFallback=1
			fi
			;;
		*)
			_matl_inheritsFallback=0
			;;
	esac
	while IFS= read -r _matl_url || [ -n "$_matl_url" ]
	do
		_matl_url=$( printf '%s\n' "$_matl_url" | sed \
			's/^[[:space:]]*//; s/[[:space:]]*$//' )
		[ -n "$_matl_url" ] || continue
		case $_matl_url in
			\#*) continue ;;
		esac
		if [ "$_matl_firstLine" -eq 1 ] \
			&& [ -n "$_mtm_marker" ]
		then
			:
		else
			case $_matl_url in
				*\$\{OUTDIR\}*)
					_matl_url=$_ms_templateLinkMarker$_matl_url
					;;
			esac
			_matl_urls=$( markshupAppendValue \
				"$_matl_urls" "$_matl_url" )
		fi
		_matl_firstLine=0
	done < "$1"
	case $2 in
		stylesheet)
			_mst_stylesheetUrls=$_matl_urls
			_mst_stylesheetInheritsFallback=$_matl_inheritsFallback
			;;
		favicon)
			_mst_faviconUrls=$_matl_urls
			_mst_faviconInheritsFallback=$_matl_inheritsFallback
			;;
		favicon-light)
			_mst_faviconLightUrls=$_matl_urls
			_mst_faviconLightInheritsFallback=$_matl_inheritsFallback
			;;
		favicon-dark)
			_mst_faviconDarkUrls=$_matl_urls
			_mst_faviconDarkInheritsFallback=$_matl_inheritsFallback
			;;
		javascript)
			_mst_javascriptUrls=$_matl_urls
			_mst_javascriptInheritsFallback=$_matl_inheritsFallback
			;;
	esac
}


