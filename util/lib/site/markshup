	if (value ~ /^<\?/) {
		return "processing"
	}
	if (value ~ /^<!\[CDATA\[/) {
		return "cdata"
	}
	if (value ~ /^<![A-Z]/) {
		return "declaration"
	}
	if (match(lowerValue, /^<(script|pre|style|textarea)([ \t>]|$)/)) {
		tag = substr(lowerValue, 2, RLENGTH - 1)
		sub(/[ \t>].*$/, "", tag)
		htmlBlockTag = tag
		return "tag"
	}
	if (lowerValue ~ ("^<(address|article|aside|base|basefont|" \
		"blockquote|body|caption|center|col|colgroup|dd|details|dialog|" \
		"dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|" \
		"frameset|h[1-6]|head|header|hr|html|iframe|legend|li|link|" \
		"main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|" \
		"section|source|summary|table|tbody|td|tfoot|th|thead|title|" \
		"tr|track|ul)([ \t>]|$)")) {
		return "blank"
	}
	if (value ~ /^<\/?[[:alpha:]][[:alnum:]:-]*([^>]*>)[ \t]*$/) {
		return "blank"
	}
	return ""
}


