# $1 - First version.
# $2 - Second version.
# Returns success when the first version is older than the second version.
markshupVersionIsOlder( )
{
	awk -v first="$1" -v second="$2" '
		BEGIN {
			firstCount = split(first, firstParts, ".")
			secondCount = split(second, secondParts, ".")
			count = firstCount > secondCount ? firstCount : secondCount
			for (partIndex = 1; partIndex <= count; partIndex++) {
				firstPart = partIndex <= firstCount ? \
					firstParts[partIndex] : 0
				secondPart = partIndex <= secondCount ? \
					secondParts[partIndex] : 0
				if (firstPart + 0 < secondPart + 0) exit 0
				if (firstPart + 0 > secondPart + 0) exit 1
			}
			exit 1
		}
	'
}


# $1 - ZIP archive path.
# $1 - ZIP archive path.
# $2 - Output directory.
markshupExtractZip( )
{
	if command -v unzip > /dev/null 2>&1
	then
		unzip -q "$1" -d "$2"
		return
	fi
	if command -v bsdtar > /dev/null 2>&1
	then
		bsdtar -xf "$1" -C "$2"
		return
	fi
	if command -v ditto > /dev/null 2>&1
	then
		ditto -x -k "$1" "$2"
		return
	fi
	if command -v jar > /dev/null 2>&1
	then
		( cd "$2" && jar xf "$1" )
		return
	fi
	if command -v 7z > /dev/null 2>&1
	then
		7z x -y "-o$2" "$1" > /dev/null
		return
	fi
	if command -v python3 > /dev/null 2>&1
	then
		python3 -m zipfile -e "$1" "$2" > /dev/null
		return
	fi
	return 1
}


# $1 - tar.xz archive path.
# $2 - Output directory.
markshupExtractXz( )
{
	xz -dc "$1" | tar -xf - -C "$2"
}


# $1 - Major version.
# $2 - Output CSV path.
# Returns success only if the release CSV is available.
markshupDownloadReleaseCsv( )
{
	_msdrc_baseUrl=${MARKSHUP_DOWNLOAD_BASE_URL:-\
https://codingmarkus.codeberg.page/MarkShup}
	markshupDownload "$_msdrc_baseUrl/latest-$1.x.csv" "$2"
}


# $1 - Major version.
# $2 - CSV path.
# Writes the latest version and matching archive URL, separated by a tab.
markshupReadRelease( )
{
	_msr_csvPath=$2
	_msr_zipUrl=
	IFS=, read -r _msr_type _msr_version _msr_extra < "$_msr_csvPath" \
		|| return 1
	case $_msr_type in
		version) ;;
		*) return 1 ;;
	esac
	case $_msr_version in
		"$1".*) ;;
		*) return 1 ;;
	esac
	while IFS=, read -r _msr_type _msr_size _msr_url
	do
		_msr_url=${_msr_url%"$( printf '\r' )"}
		case $_msr_type in
		xz)
			if command -v tar > /dev/null 2>&1 && \
				command -v xz > /dev/null 2>&1
			then
				printf '%s\t%s\t%s\n' \
					"$_msr_version" xz "$_msr_url"
				return
			fi
			;;
		zip)
			if command -v unzip > /dev/null 2>&1 || \
				command -v bsdtar > /dev/null 2>&1 || \
				command -v ditto > /dev/null 2>&1 || \
				command -v jar > /dev/null 2>&1 || \
				command -v 7z > /dev/null 2>&1 || \
				command -v python3 > /dev/null 2>&1
			then
				_msr_zipUrl=$_msr_url
			fi
			;;
		esac
	done < "$_msr_csvPath"
	if [ -n "$_msr_zipUrl" ]
	then
		printf '%s\t%s\t%s\n' "$_msr_version" zip "$_msr_zipUrl"
		return
	fi
	return 2
}


# $1 - Major version to update to.
markshupSelfUpdateMajor( )
{
	_mssum_major=$1
	_mssum_csvPath=$_ms_temporaryDirectory/release.csv
	_mssum_archivePath=$_ms_temporaryDirectory/archive
	_mssum_extractPath=$_ms_temporaryDirectory/extract

	markshupHasDownloader || markshupFail \
		'Self-update requires curl or wget to download release information'
	printf 'Finding latest version...\n'
	markshupDownloadReleaseCsv "$_mssum_major" "$_mssum_csvPath" \
		|| markshupFail \
		"Could not download release information for $_mssum_major.x"
	if _mssum_release=$( markshupReadRelease "$_mssum_major" \
		"$_mssum_csvPath" )
	then
		_mssum_status=0
	else
		_mssum_status=$?
	fi
	if [ "$_mssum_status" -eq 2 ]
	then
		markshupFail \
			'No supported extractor is available for the update archive'
	fi
	[ "$_mssum_status" -eq 0 ] || markshupFail \
		"Could not parse release information for $_mssum_major.x"
	IFS="$( printf '\t' )" read -r \
		_mssum_latest _mssum_format _mssum_url <<EOF
$_mssum_release
EOF
	printf 'Latest version is %s.\n' "$_mssum_latest"
	if ! markshupVersionIsOlder "$markshupVersion" "$_mssum_latest"
	then
		printf 'MarkShup %s is already up to date.\n' "$markshupVersion"
		return
	fi
	printf 'Downloading update...\n'
	markshupDownload "$_mssum_url" "$_mssum_archivePath" \
		|| markshupFail 'Could not download the update archive'
	mkdir -p "$_mssum_extractPath" || markshupFail \
		'Could not create a directory to decompress the update archive'
	printf 'Decompressing update...\n'
	case $_mssum_format in
		xz)
			markshupExtractXz "$_mssum_archivePath" \
				"$_mssum_extractPath" || markshupFail \
				'Could not decompress the update archive'
			;;
		zip)
			markshupExtractZip "$_mssum_archivePath" \
				"$_mssum_extractPath" || markshupFail \
				'Could not decompress the update archive'
			;;
	esac
	[ -f "$_mssum_extractPath/markshup" ] || markshupFail \
		'Update archive does not contain the expected markshup executable'
	printf 'Applying update...\n'
	chmod +x "$_mssum_extractPath/markshup" || markshupFail \
		'Could not make the updated MarkShup executable runnable'
	mv "$_mssum_extractPath/markshup" "$MARKSHUP_EXECUTABLE_PATH" \
		|| markshupFail 'Could not replace the current MarkShup executable'
	printf 'Updated MarkShup from %s to %s.\n' \
		"$markshupVersion" "$_mssum_latest"
}


# $1 - Requested major version, or latest.
markshupSelfUpgrade( )
{
	markshupHasDownloader || markshupFail \
		'Self-upgrade requires curl or wget to download release information'
	case $1 in
		latest)
			printf 'Starting self-upgrade...\n'
			printf 'Finding latest major version...\n'
			_mssu_major=${markshupVersion%%.*}
			_mssu_major=$(( _mssu_major + 1 ))
			_mssu_foundMajor=
			while markshupDownloadReleaseCsv "$_mssu_major" \
				"$_ms_temporaryDirectory/release-$_mssu_major.csv"
			do
				_mssu_foundMajor=$_mssu_major
				_mssu_major=$(( _mssu_major + 1 ))
			done
			[ -n "$_mssu_foundMajor" ] || {
				printf 'MarkShup %s is already on the latest major version.\n' \
					"$markshupVersion"
				return
			}
			printf 'Latest major version is %s.\n' "$_mssu_foundMajor"
			markshupSelfUpdateMajor "$_mssu_foundMajor"
			;;
		*[!0-9]*|'') markshupFail "Invalid major version: $1" ;;
		*)
			printf 'Starting self-upgrade...\n'
			markshupSelfUpdateMajor "$1"
			;;
	esac
}

