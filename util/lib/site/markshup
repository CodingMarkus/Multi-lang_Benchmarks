				&& option != "--no-detect-img" \
				&& option != "--default-css" \
				&& option != "--no-default-css") exit 1
			templateParseRest(line, position)
			value = templateParsed
			print option "\t" value
		}
EOF
	then
		markshupFail "Invalid option in overrides file: $1"
	fi
	while IFS="$( printf '\t' )" read -r _mso_option _mso_value \
		|| [ -n "$_mso_option" ]
	do
		_mso_value=$( printf '%b' "${_mso_value:-}" )
		case $_mso_option in
			--strip-fragment)
				case $_mso_value in
					\#*) _ms_stripFragment=$_mso_value ;;
					*) _ms_stripFragment=#$_mso_value ;;
				esac
				;;
			--title) _ms_title=$_mso_value ;;
			--header)
				case $_mso_value in
					/*) _ms_headerPath=$_mso_value ;;
					*) _ms_headerPath=$_mso_directory/$_mso_value ;;
				esac
				;;
			--footer)
				case $_mso_value in
					/*) _ms_footerPath=$_mso_value ;;
					*) _ms_footerPath=$_mso_directory/$_mso_value ;;
				esac
				;;
			--mangle)
				case $_mso_value in
					kebab|snake|keep) _ms_mangleStyle=$_mso_value ;;
					*) markshupFail "Unknown mangle style: $_mso_value" ;;
				esac
				;;
			--flavor)
				case $_mso_value in
					markshup|common|common+|extended) \
						_ms_markdownStyle=$_mso_value ;;
					*) markshupFail \
						"Unknown Markdown flavor: $_mso_value" ;;
				esac
				;;
			--copy-files|--no-copy-files|--detect-img|--no-detect-img|\
			--default-css|--no-default-css)
				[ -z "$_mso_value" ] || markshupFail \
					"Unexpected value for $_mso_option"
				case $_mso_option in
					--copy-files) _ms_copyFiles=1 ;;
					--no-copy-files) _ms_copyFiles=0 ;;
					--detect-img) _ms_imgEnabled=1 ;;
					--no-detect-img) _ms_imgEnabled=0 ;;
					--default-css) _ms_defaultCss=1 ;;
					--no-default-css) _ms_defaultCss=0 ;;
				esac
				;;
		esac
	done < "$_mso_lines"
	_mst_headerFallbackPath=$_ms_headerPath
	_mst_footerFallbackPath=$_ms_footerPath
	_mst_metaEntries=$_ms_metaEntries
	[ -z "$_ms_headerPath" ] || [ -f "$_ms_headerPath" ] \
		|| markshupFail "Header file not found: $_ms_headerPath"
	[ -z "$_ms_footerPath" ] || [ -f "$_ms_footerPath" ] \
		|| markshupFail "Footer file not found: $_ms_footerPath"
}


