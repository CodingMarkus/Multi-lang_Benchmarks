		needsSeparator = 0
		for (characterIndex = 1; characterIndex <= length($0);
			characterIndex += 1) {
			character = substr($0, characterIndex, 1)
			previous = substr($0, characterIndex - 1, 1)
			following = substr($0, characterIndex + 1, 1)
			if (character !~ /[A-Za-z0-9]/) {
				needsSeparator = result != ""
				continue
