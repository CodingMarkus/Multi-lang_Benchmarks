		while (lineIndex <= sourceCount \
			&& isListContinuation(sourceLines[lineIndex]) \
			&& index(stripListIndent(sourceLines[lineIndex], \
			listContentIndent), "|") > 0) {
			content = stripListIndent(sourceLines[lineIndex], \
				listContentIndent)
			rowCount = splitTableRow(content, tableBodyCells)
			appendListTableRow("td", tableBodyCells, rowCount, columnCount,
				tableAlignments)
			lineIndex += 1
		}
		listItem = listItem "\n</tbody>"
	}
	listItem = listItem "\n</table>"
	pendingListBreak = 0
	return lineIndex - 1
}


function closeList( )
{
	if (listType != "") {
		flushListItem()
		print "</" listType ">"
		listType = ""
	}
	pendingListBreak = 0
}


function closeIndentedCode( )
{
	if (inIndentedCode) {
		print "</code></pre>"
		inIndentedCode = 0
		pendingIndentedCodeBreaks = 0
	}
}


function flushBlocks( )
{
	flushParagraph()
	closeList()
	closeIndentedCode()
}


function headingSlug( value )
{
	value = tolower(value)
	gsub(/[^[:alnum:]_ -]/, "", value)
	gsub(/[[:space:]_-]+/, "-", value)
	sub(/^-/, "", value)
	sub(/-$/, "", value)
	return value
}


function emitHeading( level, value, identifier, \
	count )
{
	flushBlocks()
	identifier = ""
	if (supportsLessCommonExtensions() \
		&& match(value, /[[:space:]]+\{#[^[:space:]{}]+\}[[:space:]]*$/)) {
		identifier = substr(value, RSTART, RLENGTH)
		sub(/^[[:space:]]+\{#/, "", identifier)
		sub(/\}[[:space:]]*$/, "", identifier)
		value = substr(value, 1, RSTART - 1)
		sub(/[[:space:]]+$/, "", value)
	}
	if (identifier == "" && supportsCommonExtensions()) {
		identifier = headingSlug(value)
	}
	if (identifier == "") {
		print "<h" level ">" formatInline(value) "</h" level ">"
		return
	}
	count = headingIdentifiers[identifier]
	headingIdentifiers[identifier] += 1
	if (count > 0) {
		identifier = identifier "-" count
	}
	print "<h" level " id=\"" escapeHtml(identifier) "\">" \
		formatInline(value) "</h" level ">"
}


function emitAtxHeading( value, level )
{
	level = 0
	while (substr(value, level + 1, 1) == "#") {
		level += 1
	}
	if (level == 0 || level > 6 || substr(value, level + 1, 1) !~ /[[:space:]]/) {
		return 0
	}
	value = substr(value, level + 1)
	sub(/[[:space:]]+#+[[:space:]]*$/, "", value)
	sub(/^[[:space:]]+/, "", value)
	emitHeading(level, value)
	return 1
}


function appendListItem( value, type, markerWidth, start )
{
	flushParagraph()
	if (listType != "" && listType != type) {
		closeList()
	}
	if (listType == "") {
		listType = type
		print "<" type (type == "ol" && start != 1 \
			? " start=\"" start "\"" : "") ">"
	}
	pendingListBreak = 0
	flushListItem()
	listItem = formatListItem(value)
	listItemAttributes = taskListItemAttributes
	listContentIndent = markerWidth
}


function nestedListLevel( value, indentation, depth )
{
	indentation = 0
	while (substr(value, indentation + 1, 1) == " ") {
		indentation += 1
	}
	if (indentation < listContentIndent) {
		return 1
	}
	depth = 2
	while (nestedListTypes[depth] != "" \
		&& indentation >= nestedListContentIndents[depth]) {
		depth += 1
	}
	return depth
}


function flushNestedListItem( depth )
{
	if (nestedListItems[depth] != "") {
		nestedListOutput[depth] = nestedListOutput[depth] "<li" \
			nestedListItemAttributes[depth] ">" nestedListItems[depth] \
			"</li>\n"
		nestedListItems[depth] = ""
		delete nestedListItemAttributes[depth]
	}
}


function closeNestedLists( depth, closingDepth, output )
{
	for (closingDepth = nestedListDepth; closingDepth > depth;
		closingDepth -= 1) {
		flushNestedListItem(closingDepth)
		output = "<" nestedListTypes[closingDepth] \
			(nestedListTypes[closingDepth] == "ol" \
			&& nestedListStarts[closingDepth] != 1 \
			? " start=\"" nestedListStarts[closingDepth] "\"" : "") \
			">\n" \
			nestedListOutput[closingDepth] "</" \
			nestedListTypes[closingDepth] ">"
		if (closingDepth == 2) {
			listItem = listItem "\n" output
		} else {
			nestedListItems[closingDepth - 1] = \
				nestedListItems[closingDepth - 1] "\n" output
		}
		delete nestedListItems[closingDepth]
		delete nestedListOutput[closingDepth]
		delete nestedListTypes[closingDepth]
		delete nestedListContentIndents[closingDepth]
		delete nestedListStarts[closingDepth]
	}
	nestedListDepth = depth
}


function appendNestedListItem( value, type, depth, markerWidth, start )
{
	if (nestedListTypes[depth] != "" && nestedListTypes[depth] != type) {
		closeNestedLists(depth - 1)
	} else {
		closeNestedLists(depth)
	}
	if (nestedListTypes[depth] == "") {
		nestedListTypes[depth] = type
		nestedListStarts[depth] = start
	}
	flushNestedListItem(depth)
	nestedListItems[depth] = formatListItem(value)
	nestedListItemAttributes[depth] = taskListItemAttributes
	nestedListContentIndents[depth] = markerWidth
	nestedListDepth = depth
}


function formatListItem( value, state )
{
	taskListItemAttributes = ""
	if (supportsLessCommonExtensions() \
		&& value ~ /^\[[ xX]\]([ \t]+|$)/) {
		state = tolower(substr(value, 2, 1))
		sub(/^\[[ xX]\][ \t]*/, "", value)
		taskListItemAttributes = " class=\"task-list-item\""
		value = "<input type=\"checkbox\" disabled" \
			(state == "x" ? " checked" : "") "> " value
	}
	return formatParagraphLine(value)
}


function trim( value )
{
	sub(/^[[:space:]]+/, "", value)
	sub(/[[:space:]]+$/, "", value)
	return value
}


function splitTableRow( value, cells, count, \
	characterIndex, character, inCode )
{
	value = trim(value)
	if (substr(value, 1, 1) == "|") {
		value = substr(value, 2)
	}
	if (substr(value, length(value), 1) == "|") {
		value = substr(value, 1, length(value) - 1)
	}
	count = 1
	cells[count] = ""
	inCode = 0
	for (characterIndex = 1; characterIndex <= length(value);
		characterIndex += 1) {
		character = substr(value, characterIndex, 1)
		if (character == "\\" && characterIndex < length(value)) {
			cells[count] = cells[count] character \
				substr(value, characterIndex + 1, 1)
			characterIndex += 1
			continue
		}
		if (character == "`") {
			inCode = !inCode
		}
		if (character == "|" && !inCode) {
			count += 1
			cells[count] = ""
		} else {
			cells[count] = cells[count] character
		}
	}
	for (cellIndex = 1; cellIndex <= count; cellIndex += 1) {
		cells[cellIndex] = trim(cells[cellIndex])
	}
	return count
}


function tableAlignment( value )
{
	if (value ~ /^:-+:[[:space:]]*$/) {
		return "center"
	}
	if (value ~ /^:-+[[:space:]]*$/) {
		return "left"
	}
	if (value ~ /^-+:[[:space:]]*$/) {
		return "right"
	}
	return ""
}


function isTableDivider( value, count )
{
	value = trim(value)
	if (index(value, "|") == 0) {
		return 0
	}
	count = splitTableRow(value, tableDividerCells)
	if (count == 0) {
		return 0
	}
	for (cellIndex = 1; cellIndex <= count; cellIndex += 1) {
		if (tableDividerCells[cellIndex] !~ /^:?-+:?$/) {
			return 0
		}
	}
	return 1
}


function isTableStart( sourceLines, sourceCount, lineIndex, \
	headerCount, dividerCount )
{
	if (inFence || inIndentedCode || listType != "" \
		|| lineIndex >= sourceCount \
		|| sourceLines[lineIndex] ~ \
			/^(    |\t|>|[-+*][ \t]+|[0-9][0-9]*\.[ \t]+)/ \
		|| index(sourceLines[lineIndex], "|") == 0) {
		return 0
	}
	if (!isTableDivider(sourceLines[lineIndex + 1])) {
		return 0
	}
	headerCount = splitTableRow(sourceLines[lineIndex], tableHeaderCells)
	dividerCount = splitTableRow(sourceLines[lineIndex + 1], \
		tableDividerCells)
	return headerCount == dividerCount
}


function emitTableRow( tag, cells, count, \
	columnCount, alignment )
{
	print "<tr>"
	for (cellIndex = 1; cellIndex <= columnCount; cellIndex += 1) {
		if (cellIndex <= count) {
			cell = cells[cellIndex]
		} else {
			cell = ""
		}
		if (alignment[cellIndex] != "") {
			print "<" tag " align=\"" alignment[cellIndex] "\">" \
				formatInline(cell) "</" tag ">"
		} else {
			print "<" tag ">" formatInline(cell) "</" tag ">"
		}
	}
	print "</tr>"
}


function emitTable( sourceLines, sourceCount, lineIndex, \
	columnCount, rowCount )
{
	flushBlocks()
	columnCount = splitTableRow(sourceLines[lineIndex], tableHeaderCells)
	splitTableRow(sourceLines[lineIndex + 1], tableDividerCells)
	for (cellIndex = 1; cellIndex <= columnCount; cellIndex += 1) {
		tableAlignments[cellIndex] = tableAlignment(tableDividerCells[cellIndex])
	}
	print "<table>"
	print "<thead>"
	emitTableRow("th", tableHeaderCells, columnCount, columnCount,
		tableAlignments)
	print "</thead>"
	lineIndex += 2
	if (lineIndex <= sourceCount \
		&& index(sourceLines[lineIndex], "|") > 0) {
		print "<tbody>"
		while (lineIndex <= sourceCount \
			&& index(sourceLines[lineIndex], "|") > 0) {
			rowCount = splitTableRow(sourceLines[lineIndex], \
				tableBodyCells)
			emitTableRow("td", tableBodyCells, rowCount, columnCount,
				tableAlignments)
			lineIndex += 1
		}
		print "</tbody>"
	}
	print "</table>"
	return lineIndex - 1
}


function isSetextHeading( sourceLines, sourceCount, lineIndex, marker )
{
	return !inFence \
		&& !inIndentedCode \
		&& sourceLines[lineIndex] !~ /^[[:space:]]*$/ \
		&& lineIndex < sourceCount \
		&& sourceLines[lineIndex + 1] ~ ("^" marker "+[[:space:]]*$")
}


function isDefinitionListStart( sourceLines, sourceCount, lineIndex )
{
	return !inFence \
		&& !inIndentedCode \
		&& sourceLines[lineIndex] !~ /^[[:space:]]*$/ \
		&& sourceLines[lineIndex] !~ \
			/^(    |\t|>|[-+*][ \t]+|[0-9][0-9]*\.[ \t]+)/ \
		&& lineIndex < sourceCount \
		&& sourceLines[lineIndex + 1] ~ /^:[ \t]+/
}


function emitDefinitionList( sourceLines, sourceCount, lineIndex, \
	term, definition )
{
	flushBlocks()
	print "<dl>"
	while (lineIndex < sourceCount \
		&& isDefinitionListStart(sourceLines, sourceCount, lineIndex)) {
		term = sourceLines[lineIndex]
		print "<dt>" formatInline(term) "</dt>"
		lineIndex += 1
		while (lineIndex <= sourceCount \
			&& sourceLines[lineIndex] ~ /^:[ \t]+/) {
			definition = sourceLines[lineIndex]
			sub(/^:[ \t]+/, "", definition)
			print "<dd>" formatParagraphLine(definition) "</dd>"
			lineIndex += 1
		}
	}
	print "</dl>"
	return lineIndex - 1
}


function stripQuoteMarker( value )
{
	sub(/^>/, "", value)
	sub(/^ /, "", value)
	return value
}


function emitBlockQuote( sourceLines, sourceCount, lineIndex, \
	quoteLineCount, quoteIndex, quoteBodyCount, type )
{
	flushBlocks()
	quoteLineCount = 0
	while (lineIndex <= sourceCount && sourceLines[lineIndex] ~ /^>/) {
		quoteLines[++quoteLineCount] = \
			stripQuoteMarker(sourceLines[lineIndex])
		lineIndex += 1
	}
	for (quoteIndex = 1; quoteIndex <= quoteLineCount; quoteIndex += 1) {
		isReferenceDefinition(quoteLines[quoteIndex])
	}
	type = supportsLessCommonExtensions() \
		? admonitionType(quoteLines[1]) : ""
	if (type == "") {
		print "<blockquote>"
		processLines(quoteLines, quoteLineCount)
	} else {
		print "<blockquote class=\"admonition admonition-" type "\">"
		print "<p class=\"admonition-title\">" admonitionTitle(type) "</p>"
		quoteBodyCount = 0
		for (quoteIndex = 2; quoteIndex <= quoteLineCount; quoteIndex += 1) {
			quoteBodyLines[++quoteBodyCount] = quoteLines[quoteIndex]
		}
		processLines(quoteBodyLines, quoteBodyCount)
		for (quoteIndex = 1; quoteIndex <= quoteBodyCount; quoteIndex += 1) {
			delete quoteBodyLines[quoteIndex]
		}
	}
	flushBlocks()
	print "</blockquote>"
	for (quoteIndex = 1; quoteIndex <= quoteLineCount; quoteIndex += 1) {
		delete quoteLines[quoteIndex]
	}
	return lineIndex - 1
}


function processLines( sourceLines, sourceCount, lineIndex )
{
	for (lineIndex = 1; lineIndex <= sourceCount; lineIndex += 1) {
		if (inFence || inHtmlBlock || inHtmlComment) {
			processLine(sourceLines[lineIndex])
			continue
		}
		if (inIndentedCode && sourceLines[lineIndex] !~ /^(    |\t|$)/) {
			closeIndentedCode()
		}
		if (isFootnoteDefinition(sourceLines[lineIndex]) \
			|| isReferenceDefinition(sourceLines[lineIndex])) {
			continue
		}
		if (listType != "" && nestedListDepth <= 1 \
			&& isListContinuation(sourceLines[lineIndex]) \
			&& lineIndex < sourceCount \
			&& isListContinuation(sourceLines[lineIndex + 1]) \
			&& isTableDivider(stripListIndent( \
			sourceLines[lineIndex + 1], listContentIndent))) {
			lineIndex = emitListTable(sourceLines, sourceCount, lineIndex)
			continue
		}
		if (pendingListBreak \
			&& sourceLines[lineIndex] != "" \
			&& !isListContinuation(sourceLines[lineIndex]) \
			&& sourceLines[lineIndex] !~ /^[-+*][ \t]+/ \
			&& sourceLines[lineIndex] !~ /^[0-9][0-9]*\.[ \t]+/ \
			&& sourceLines[lineIndex] !~ /^[ \t]+[-+*][ \t]+/ \
			&& sourceLines[lineIndex] !~ \
				/^[ \t]+[0-9][0-9]*\.[ \t]+/) {
			closeList()
		}
		if (isSetextHeading(sourceLines, sourceCount, lineIndex, "=")) {
			emitHeading(1, sourceLines[lineIndex])
			lineIndex += 1
			continue
		}
		if (isSetextHeading(sourceLines, sourceCount, lineIndex, "-")) {
			emitHeading(2, sourceLines[lineIndex])
			lineIndex += 1
			continue
		}
		if (supportsCommonExtensions() \
			&& isTableStart(sourceLines, sourceCount, lineIndex)) {
			lineIndex = emitTable(sourceLines, sourceCount, lineIndex)
			continue
		}
		if (supportsLessCommonExtensions() \
			&& isDefinitionListStart(sourceLines, sourceCount, lineIndex)) {
			lineIndex = emitDefinitionList(sourceLines, sourceCount, \
				lineIndex)
			continue
		}
		if (sourceLines[lineIndex] ~ /^>/) {
			lineIndex = emitBlockQuote(sourceLines, sourceCount, lineIndex)
			continue
		}
		processLine(sourceLines[lineIndex])
	}
}


function processLine( value, content )
{
	if (inFence) {
		if (isClosingFence(value)) {
			print inMermaidFence ? "</pre>" : "</code></pre>"
			inFence = 0
			inMermaidFence = 0
			fenceMarker = ""
			fenceLength = 0
			fenceIndent = 0
		} else {
			print escapeHtml(stripFenceIndent(value, fenceIndent))
		}
		return
	}
	if (inIndentedCode) {
		if (value ~ /^    /) {
			while (pendingIndentedCodeBreaks > 0) {
				print ""
				pendingIndentedCodeBreaks -= 1
			}
			print escapeHtml(substr(value, 5))
			return
		}
		if (value ~ /^\t/) {
			while (pendingIndentedCodeBreaks > 0) {
				print ""
				pendingIndentedCodeBreaks -= 1
			}
			print escapeHtml(substr(value, 2))
			return
		}
		if (value == "") {
			pendingIndentedCodeBreaks += 1
			return
		}
		closeIndentedCode()
	}
	if (inHtmlBlock) {
		if (htmlBlockType == "blank" && value == "") {
			inHtmlBlock = 0
			htmlBlockType = ""
			htmlBlockTag = ""
			return
		}
		print rewriteHtmlReferences(value)
		if (htmlBlockEnds(value)) {
			inHtmlBlock = 0
			htmlBlockType = ""
			htmlBlockTag = ""
		}
		return
	}
	if (inHtmlComment) {
		print rewriteHtmlReferences(value)
		if (value ~ /-->/) {
			inHtmlComment = 0
		}
		return
	}
	if (pendingListBreak \
		&& value != "" \
		&& !isListContinuation(value) \
		&& value !~ /^[-+*][ \t]+/ \
		&& value !~ /^[0-9][0-9]*\.[ \t]+/ \
		&& value !~ /^[ \t]+[-+*][ \t]+/ \
		&& value !~ /^[ \t]+[0-9][0-9]*\.[ \t]+/) {
		closeList()
	}
	if (listType != "" \
		&& value ~ /^[ \t]+[-+*][ \t]+/) {
		if (nestedListLevel(value) > 1) {
			content = value
			sub(/^[ \t]+[-+*][ \t]+/, "", content)
			markerWidth = length(value) - length(content)
			appendNestedListItem(content, "ul", nestedListLevel(value), \
				markerWidth, 1)
			pendingListBreak = 0
			return
		}
	}
	if (listType != "" \
		&& value ~ /^[ \t]+[0-9][0-9]*\.[ \t]+/) {
		if (nestedListLevel(value) > 1) {
			content = value
			start = value
			sub(/^[ \t]+/, "", start)
			sub(/\..*$/, "", start)
			sub(/^[ \t]+[0-9][0-9]*\.[ \t]+/, "", content)
			markerWidth = length(value) - length(content)
			appendNestedListItem(content, "ol", nestedListLevel(value), \
				markerWidth, start)
			pendingListBreak = 0
			return
		}
	}
	if (value == "") {
		flushParagraph()
		if (listType != "") {
			if (listBlockType == "quote") {
				listItem = listItem "</p>\n</blockquote>"
				listBlockType = ""
			}
			if (inListParagraph) {
				listItem = listItem "</p>"
				inListParagraph = 0
			}
			if (listBlockType == "fence" \
				|| listBlockType == "indented-code") {
				listItem = listItem "\n"
				return
			}
			pendingListBreak = 1
		}
		return
	}
	if (listType != "" && (isListContinuation(value) \
		|| isLazyListContinuation(value))) {
		if (nestedListDepth > 1) {
			content = value
			sub(/^  /, "", content)
			nestedListItems[nestedListDepth] = \
				nestedListItems[nestedListDepth] "\n" \
				formatParagraphLine(content)
			pendingListBreak = 0
			return
		}
		appendListContinuation(value)
		return
	}
	if (parseFence(value)) {
		flushParagraph()
		closeList()
		fenceLanguageName = fenceLanguage(parsedFenceInformation)
		inMermaidFence = mermaidEnabled && fenceLanguageName == "mermaid"
		if (inMermaidFence) {
			printf "%s", "<pre class=\"mermaid\">"
		} else {
			printf "%s", "<pre><code" \
				(fenceLanguageName == "" ? "" : " class=\"language-" \
				escapeHtml(fenceLanguageName) "\"") ">"
		}
		inFence = 1
		fenceMarker = parsedFenceMarker
		fenceLength = parsedFenceLength
		fenceIndent = parsedFenceIndent
		return
	}
	if (value ~ /^    /) {
		flushParagraph()
		closeList()
		printf "%s", "<pre><code>"
		print escapeHtml(substr(value, 5))
		inIndentedCode = 1
		return
	}
	if (value ~ /^\t/) {
		flushParagraph()
		closeList()
		printf "%s", "<pre><code>"
		print escapeHtml(substr(value, 2))
		inIndentedCode = 1
		return
	}
	if ((htmlBlockType = htmlBlockStartType(value)) != "") {
		flushBlocks()
		print rewriteHtmlReferences(value)
		if (htmlBlockType == "comment") {
			inHtmlComment = value !~ /-->/
		} else {
			inHtmlBlock = !htmlBlockEnds(value)
		}
		return
	}
	if (value ~ /^[-+*][ \t]+/) {
		content = value
		sub(/^[-+*][ \t]+/, "", content)
		appendListItem(content, "ul", length(value) - length(content), 1)
		return
	}
	if (value ~ /^[0-9][0-9]*\.[ \t]+/) {
		content = value
		start = value
		sub(/\..*$/, "", start)
		sub(/^[0-9][0-9]*\.[ \t]+/, "", content)
		appendListItem(content, "ol", length(value) - length(content), start)
		return
	}
	if (listType != "") {
		closeList()
	}
	if (value ~ /^---+$/) {
		flushParagraph()
		print "<hr>"
		return
	}
	if (emitAtxHeading(value)) {
		return
	}
	appendParagraph(value)
}


{
	lines[++lineCount] = $0
}


