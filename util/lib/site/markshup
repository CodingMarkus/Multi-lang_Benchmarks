# $1 - Error message.
markshupFail( )
{
	case $1 in
		*[.!]) _ms_error=$1 ;;
		*) _ms_error=$1. ;;
	esac
	printf 'markshup: %s\n' "$_ms_error" >&2
	[ "$#" -ge 2 ] && printf '%s\n' "$2" >&2
	exit 1
}


# $1 - Current tab-separated value list.
# $2 - Value to append.
markshupAppendValue( )
{
	if [ -n "$1" ]
	then
		printf '%s\t%s\n' "$1" "$2"
	else
		printf '%s\n' "$2"
	fi
}


# $1 - Current newline-separated value list.
# $2 - Value to append.
markshupAppendLine( )
{
	if [ -n "$1" ]
	then
		printf '%s\n%s\n' "$1" "$2"
	else
		printf '%s\n' "$2"
	fi
}


# $1 - Metadata value.
markshupEncodeMeta( )
{
	MARKSHUP_META_VALUE=$1 awk '
		BEGIN {
			value = ENVIRON["MARKSHUP_META_VALUE"]
			result = ""
			for (characterIndex = 1; characterIndex <= length(value); \
				characterIndex++) {
				character = substr(value, characterIndex, 1)
				if (character == "\\") result = result "\\\\"
				else if (character == "\t") result = result "\\t"
				else if (character == "\n") result = result "\\n"
				else if (character == "\r") result = result "\\r"
				else if (character == "\"") result = result "\\\""
				else result = result character
			}
			print result
		}
	'
}


# $1 - Existing file path.
markshupAbsoluteFilePath( )
{
	case $1 in
		*/*)
			_mafp_directory=${1%/*}
			_mafp_name=${1##*/}
			;;
		*)
			_mafp_directory=.
			_mafp_name=$1
			;;
	esac
	_mafp_directory=$( CDPATH='' cd "$_mafp_directory" 2> /dev/null && pwd ) \
		|| return 1
	[ -f "$_mafp_directory/$_mafp_name" ] || return 1
	printf '%s/%s\n' "$_mafp_directory" "$_mafp_name"
}


# $1 - Existing directory path.
markshupAbsoluteDirectoryPath( )
{
	_madp_directory=$( CDPATH='' cd "$1" 2> /dev/null && pwd ) || return 1
	[ -d "$_madp_directory" ] || return 1
	printf '%s\n' "$_madp_directory"
}


# $@ - MarkShup command-line arguments.
markshupMain( )
{
	_ms_hadArguments=$#
	_ms_inputPath=
	_ms_outputPath=
	_ms_stylesheetPaths=
	_ms_stylesheetRefs=
	_ms_faviconPaths=
	_ms_faviconRefs=
	_ms_faviconLightPaths=
	_ms_faviconLightRefs=
	_ms_faviconDarkPaths=
	_ms_faviconDarkRefs=
	_ms_javascriptPaths=
	_ms_javascriptRefs=
	_ms_jsHelperPath=
	_ms_jsHelperMode=auto
	_ms_mermaidEnabled=0
	_ms_mermaidJavascriptPaths=
	_ms_mermaidJavascriptRefs=
	_ms_mermaidJavascriptInlinePath=
	_ms_metaEntries=
	_ms_stripFragment=
	_ms_title=
	_ms_headerPath=
	_ms_footerPath=
	_ms_templatesPath=
	_ms_mangleStyle=keep
	_ms_markdownStyle=markshup
	_ms_defaultCss=1
	_ms_imgEnabled=1
	_ms_copyFiles=1
	_ms_recursive=0
	_ms_temporaryDirectory=$( mktemp -d "${TMPDIR:-/tmp}/markshup.XXXXXX" ) \
		|| markshupFail 'Could not create a temporary directory'

	trap markshupCleanup EXIT HUP INT TERM

	while [ "$#" -gt 0 ]
	do
		case $1 in
			--css|--css-ref|--icon|--icon-ref|\
			--icon-light|--icon-light-ref|\
			--icon-dark|--icon-dark-ref|--js|--js-ref|--js-helper|\
			--js-helper-mode|\
			--strip-fragment|--title|--header|--footer|\
			--templates|--mangle|--flavor)
				[ "$#" -ge 2 ] || markshupFail "Missing value for $1"
				_ms_option=$1
				_ms_value=$2
				case $_ms_option in
					--css)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail \
							"Stylesheet file not found: $2"
						_ms_stylesheetPaths=$( markshupAppendValue \
							"$_ms_stylesheetPaths" "$_ms_value" )
						;;
					--css-ref)
						_ms_stylesheetRefs=$( markshupAppendValue \
							"$_ms_stylesheetRefs" "$_ms_value" )
						;;
					--icon)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail "Icon file not found: $2"
						_ms_faviconPaths=$( markshupAppendValue \
							"$_ms_faviconPaths" "$_ms_value" )
						;;
					--icon-ref)
						_ms_faviconRefs=$( markshupAppendValue \
							"$_ms_faviconRefs" "$_ms_value" )
						;;
					--icon-light)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail "Icon file not found: $2"
						_ms_faviconLightPaths=$( markshupAppendValue \
							"$_ms_faviconLightPaths" "$_ms_value" )
						;;
					--icon-light-ref)
						_ms_faviconLightRefs=$( markshupAppendValue \
							"$_ms_faviconLightRefs" "$_ms_value" )
						;;
					--icon-dark)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail "Icon file not found: $2"
						_ms_faviconDarkPaths=$( markshupAppendValue \
							"$_ms_faviconDarkPaths" "$_ms_value" )
						;;
					--icon-dark-ref)
						_ms_faviconDarkRefs=$( markshupAppendValue \
							"$_ms_faviconDarkRefs" "$_ms_value" )
						;;
					--js)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail \
							"JavaScript file not found: $2"
						_ms_javascriptPaths=$( markshupAppendValue \
							"$_ms_javascriptPaths" "$_ms_value" )
						;;
					--js-ref)
						_ms_javascriptRefs=$( markshupAppendValue \
							"$_ms_javascriptRefs" "$_ms_value" )
						;;
					--js-helper)
						_ms_jsHelperPath=$_ms_value
						;;
					--js-helper-mode)
						case $_ms_value in
							auto|local|external)
								_ms_jsHelperMode=$_ms_value
								;;
							*)
								markshupFail \
									"Unknown JavaScript helper mode: $2"
								;;
						esac
						;;
					--strip-fragment)
						case $_ms_value in
							\#*) _ms_stripFragment=$_ms_value ;;
							*) _ms_stripFragment=#$_ms_value ;;
						esac
						;;
					--title)
						_ms_title=$_ms_value
						;;
					--header)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail "Header file not found: $2"
						_ms_headerPath=$_ms_value
						;;
					--footer)
						_ms_value=$( markshupAbsoluteFilePath "$_ms_value" ) \
							|| markshupFail "Footer file not found: $2"
						_ms_footerPath=$_ms_value
						;;
					--templates)
						_ms_templatesPath=$( markshupAbsoluteDirectoryPath \
							"$_ms_value" ) || markshupFail \
							"Template directory not found: $2"
						;;
					--mangle)
						case $_ms_value in
							kebab|snake|keep)
								_ms_mangleStyle=$_ms_value
								;;
							*)
								markshupFail \
									"Unknown mangle style: $_ms_value"
								;;
						esac
						;;
					--flavor)
						case $_ms_value in
							markshup|common|common+|extended)
								_ms_markdownStyle=$_ms_value
								;;
							*)
								markshupFail \
									"Unknown Markdown flavor: $_ms_value"
								;;
						esac
						;;
				esac
				shift 2
				;;
			--meta)
				[ "$#" -ge 3 ] || markshupFail "Missing value for $1"
				_ms_metaName=$( markshupEncodeMeta "$2" )
				_ms_metaValue=$( markshupEncodeMeta "$3" )
				_ms_metaEntries=$( markshupAppendLine \
					"$_ms_metaEntries" "$_ms_metaName	$_ms_metaValue" )
				shift 3
				;;
			--default-css)
				_ms_defaultCss=1
				shift
				;;
			--no-default-css)
				_ms_defaultCss=0
				shift
				;;
			--detect-img)
				_ms_imgEnabled=1
				shift
				;;
			--no-detect-img|--disable-img)
				_ms_imgEnabled=0
				shift
				;;
			--copy-files)
				_ms_copyFiles=1
				shift
				;;
			--no-copy-files)
				_ms_copyFiles=0
				shift
				;;
			--recursive)
				_ms_recursive=1
				shift
				;;
			-h|-help|--help)
				markshupUsage
				exit 0
				;;
			--version)
				printf 'MarkShup %s\n' "$markshupVersion"
				exit 0
				;;
			--selfupdate)
				[ "$#" -eq 1 ] || markshupFail "Unexpected argument: $2"
				[ "$MARKSHUP_SELFUPDATE_AVAILABLE" -eq 1 ] || \
					markshupFail \
					'Self-update is only available in deployed MarkShup'
				printf 'Starting self-update...\n'
				markshupSelfUpdateMajor "${markshupVersion%%.*}"
				exit 0
				;;
			--selfupgrade)
				[ "$#" -ge 2 ] || markshupFail "Missing value for $1"
				[ "$#" -eq 2 ] || markshupFail "Unexpected argument: $3"
				[ "$MARKSHUP_SELFUPDATE_AVAILABLE" -eq 1 ] || \
					markshupFail \
					'Self-update is only available in deployed MarkShup'
				markshupSelfUpgrade "$2"
				exit 0
				;;
			--)
				shift
				break
				;;
			-*)
				markshupFail "Unknown option: $1"
				;;
			*)
				break
				;;
		esac
	done

	if [ "$#" -lt 1 ]
	then
		if [ "$_ms_hadArguments" -eq 0 ]
		then
			markshupFail 'Missing input path' 'Use --help for details.'
		fi
		markshupFail 'Missing input path'
	fi
	_ms_inputPath=$1
	shift
	[ "$#" -ge 1 ] || markshupFail 'Missing output directory'
	_ms_outputPath=$1
	shift
	[ "$#" -eq 0 ] || markshupFail "Unexpected argument: $1"

	[ -f "$MARKSHUP_RENDERER_PATH" ] \
		|| markshupFail 'Markdown renderer not found'
	[ "$_ms_defaultCss" -eq 0 ] || [ -f "$MARKSHUP_DEFAULT_CSS_PATH" ] \
		|| markshupFail 'Default stylesheet not found'
	[ -z "$_ms_headerPath" ] || [ -f "$_ms_headerPath" ] \
		|| markshupFail "Header file not found: $_ms_headerPath"
	[ -z "$_ms_footerPath" ] || [ -f "$_ms_footerPath" ] \
		|| markshupFail "Footer file not found: $_ms_footerPath"
	[ ! -e "$_ms_outputPath" ] || [ -d "$_ms_outputPath" ] \
		|| markshupFail "Output path is not a directory: $_ms_outputPath"

	_ms_cli_metaEntries=$_ms_metaEntries
	_ms_cli_stripFragment=$_ms_stripFragment
	_ms_cli_title=$_ms_title
	_ms_cli_headerPath=$_ms_headerPath
	_ms_cli_footerPath=$_ms_footerPath
	_ms_cli_mangleStyle=$_ms_mangleStyle
	_ms_cli_markdownStyle=$_ms_markdownStyle
	_ms_cli_defaultCss=$_ms_defaultCss
	_ms_cli_imgEnabled=$_ms_imgEnabled
	_ms_cli_copyFiles=$_ms_copyFiles

	mkdir -p "$_ms_outputPath"
	_ms_outputDirectory=$( CDPATH='' cd "$_ms_outputPath" && pwd )

	if [ -f "$_ms_inputPath" ]
	then
		_ms_inputFile=$( markshupAbsoluteFilePath "$_ms_inputPath" )
		_ms_inputRoot=${_ms_inputFile%/*}
		markshupConvert "$_ms_inputFile"
		return
	fi

	if [ -d "$_ms_inputPath" ]
	then
		_ms_inputRoot=$( CDPATH='' cd "$_ms_inputPath" && pwd )
		markshupConvertDirectory "$_ms_inputRoot"
		return
	fi

	markshupFail "Input path not found: $_ms_inputPath"
}

markshupMain "$@"
exit $?
