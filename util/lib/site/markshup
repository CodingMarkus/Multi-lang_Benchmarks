# $1 - Markdown source path.
#
# Returns success if the source contains a Mermaid fenced code block.
markshupSourceHasMermaid( )
{
	awk '
		function parseFence(value, indentation, characterIndex, marker,
			fenceSize, information) {
			indentation = 0
			while (indentation < 3 && \
				substr(value, indentation + 1, 1) == " ") {
				indentation += 1
			}
			characterIndex = indentation + 1
			marker = substr(value, characterIndex, 1)
			if (marker != "`" && marker != "~") {
				return 0
			}
			fenceSize = 0
			while (substr(value, characterIndex, 1) == marker) {
				fenceSize += 1
				characterIndex += 1
			}
			if (fenceSize < 3) {
				return 0
			}
			information = substr(value, characterIndex)
			if (marker == "`" && index(information, "`") > 0) {
				return 0
			}
			parsedMarker = marker
			parsedLength = fenceSize
			parsedInformation = information
			return 1
		}
		{
			value = $0
			while (value ~ /^>/) {
				sub(/^>[ \t]?/, "", value)
			}
			if (!parseFence(value)) {
				next
			}
			if (inFence) {
				if (parsedMarker == fenceMarker \
					&& parsedLength >= fenceLength \
					&& parsedInformation ~ /^[ \t]*$/) {
					inFence = 0
				}
				next
			}
			information = parsedInformation
			sub(/^[ \t]*/, "", information)
			sub(/[ \t].*$/, "", information)
			if (information == "mermaid") {
				found = 1
				exit
			}
			inFence = 1
			fenceMarker = parsedMarker
			fenceLength = parsedLength
		}
		END {
			exit(!found)
		}
	' "$1"
}


