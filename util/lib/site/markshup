function formatInline( value, allowAutomaticLinks, output, \
	opening, openingLength, search, searchOffset, closing, \
	closingLength, code, matched )
{
	if (allowAutomaticLinks == "") {
		allowAutomaticLinks = 1
	}
	output = ""
	while (match(value, /`+/)) {
		opening = RSTART
		openingLength = RLENGTH
		output = output substr(value, 1, opening - 1)
		search = substr(value, opening + openingLength)
		searchOffset = 1
		matched = 0
		while (match(substr(search, searchOffset), /`+/)) {
			closing = searchOffset + RSTART - 1
			closingLength = RLENGTH
			if (closingLength == openingLength) {
				code = normalizeCodeSpan(substr(search, 1, closing - 1))
				output = output inlineHtmlToken("<code>" \
					escapeHtml(code) "</code>")
				value = substr(search, closing + closingLength)
				matched = 1
				break
			}
			searchOffset = closing + closingLength
		}
		if (!matched) {
			output = output delimiterLiteral("`", openingLength)
			value = search
			continue
		}
	}
	return formatPlainText(output value, allowAutomaticLinks)
}


function htmlBlockStartType( value, lowerValue, tag )
{
	lowerValue = tolower(value)
	if (value ~ /^<!--/) {
		return "comment"
