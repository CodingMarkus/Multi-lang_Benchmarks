function parseLinkDestination( value, titleMarker, titleEnd, \
	separator )
{
	value = trimInlineWhitespace(value)
	linkUrl = ""
	linkTitle = ""
	if (substr(value, 1, 1) == "<") {
		titleEnd = index(value, ">")
		if (titleEnd == 0) {
			return 0
		}
		linkUrl = substr(value, 2, titleEnd - 2)
		value = trimInlineWhitespace(substr(value, titleEnd + 1))
	} else {
		separator = match(value, /[ \t]/)
		if (separator == 0) {
			linkUrl = value
			return linkUrl != ""
		}
		linkUrl = substr(value, 1, separator - 1)
		value = trimInlineWhitespace(substr(value, separator))
	}
	if (value == "") {
		return linkUrl != ""
	}
	titleMarker = substr(value, 1, 1)
	titleEnd = titleMarker == "(" ? ")" : titleMarker
	if ((titleMarker != "\"" && titleMarker != "'" \
		&& titleMarker != "(") \
		|| substr(value, length(value), 1) != titleEnd) {
		return 0
	}
	linkTitle = substr(value, 2, length(value) - 2)
	return linkUrl != ""
}


function findInlineLink( value, position, character, \
	labelStart, labelEnd, depth, destinationStart, destinationEnd, \
	quote, referenceEnd, reference, destination )
{
	inlineLinkFound = 0
	for (position = 1; position <= length(value); position += 1) {
		if (substr(value, position, 1) != "[") {
			continue
		}
		labelStart = position + 1
		depth = 1
		for (labelEnd = labelStart; labelEnd <= length(value);
			labelEnd += 1) {
			character = substr(value, labelEnd, 1)
			if (character == "[") {
				depth += 1
			} else if (character == "]") {
				depth -= 1
				if (depth == 0) {
					break
				}
			}
		}
		if (depth != 0) {
			continue
		}
		inlineLinkStart = position > 1 \
			&& substr(value, position - 1, 1) == "!" \
			? position - 1 : position
		inlineLinkImage = inlineLinkStart != position
		inlineLinkLabel = substr(value, labelStart, labelEnd - labelStart)
		destinationStart = labelEnd + 1
		if (substr(value, destinationStart, 1) == "(") {
			depth = 1
			quote = ""
			for (destinationEnd = destinationStart + 1;
				destinationEnd <= length(value); destinationEnd += 1) {
				character = substr(value, destinationEnd, 1)
				if (quote != "") {
					if (character == quote) {
						quote = ""
					}
					continue
				}
				if (character == "\"" || character == "'") {
					quote = character
					continue
				}
				if (character == "(") {
					depth += 1
				} else if (character == ")") {
					depth -= 1
					if (depth == 0) {
						break
					}
				}
			}
			if (depth != 0 \
				|| !parseLinkDestination(substr(value, \
				destinationStart + 1, \
				destinationEnd - destinationStart - 1))) {
				continue
			}
			inlineLinkLength = destinationEnd - inlineLinkStart + 1
			inlineLinkFound = 1
			return 1
		}
		if (substr(value, destinationStart, 1) == "[") {
			referenceEnd = index(substr(value, destinationStart + 1), "]")
			if (referenceEnd == 0) {
				continue
			}
			reference = substr(value, destinationStart + 1, referenceEnd - 1)
			inlineLinkLength = destinationStart + referenceEnd \
				- inlineLinkStart + 1
		} else {
			reference = inlineLinkLabel
			inlineLinkLength = labelEnd - inlineLinkStart + 1
		}
		reference = normalizeReferenceLabel(reference)
		if (reference == "" || !(reference in referenceUrls)) {
			continue
		}
		linkUrl = referenceUrls[reference]
		linkTitle = referenceTitles[reference]
		inlineLinkFound = 1
		return 1
	}
	return 0
}


