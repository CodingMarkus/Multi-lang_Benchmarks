markshupRenderFile( )
{
	_mrf_input=$1
	_mrf_output=$2
	_mrf_title=$3
	_ms_templateLinkMarker=$( printf '\037' )
	_mrf_temporaryOutput=$_ms_temporaryDirectory/output.html
	_mrf_stylesheetUrls=$( markshupAssetUrls \
		"$_ms_stylesheetPaths" "$_mrf_output" )
	_mrf_stylesheetUrls=$( markshupAppendValue \
		"$_mrf_stylesheetUrls" "$_ms_stylesheetRefs" )
	_mrf_faviconUrls=$( markshupAssetUrls \
		"$_ms_faviconPaths" "$_mrf_output" )
	_mrf_faviconUrls=$( markshupAppendValue \
		"$_mrf_faviconUrls" "$_ms_faviconRefs" )
	_mrf_faviconLightUrls=$( markshupAssetUrls \
		"$_ms_faviconLightPaths" "$_mrf_output" )
	_mrf_faviconLightUrls=$( markshupAppendValue \
		"$_mrf_faviconLightUrls" "$_ms_faviconLightRefs" )
	_mrf_faviconDarkUrls=$( markshupAssetUrls \
		"$_ms_faviconDarkPaths" "$_mrf_output" )
	_mrf_faviconDarkUrls=$( markshupAppendValue \
		"$_mrf_faviconDarkUrls" "$_ms_faviconDarkRefs" )
	_mrf_javascriptUrls=$( markshupAssetUrls \
		"$_ms_javascriptPaths" "$_mrf_output" )
	_mrf_javascriptUrls=$( markshupAppendValue \
		"$_mrf_javascriptUrls" "$_ms_javascriptRefs" )
	markshupSelectTemplates "${_mrf_input%/*}"
	_mrf_title=$( markshupTitleFromPath "$_mrf_input" )
	if [ -n "$_ms_title" ]
	then
		_mrf_title=$_ms_title': '$_mrf_title
	fi
	if [ "$_ms_mermaidEnabled" -eq 1 ] \
		&& markshupSourceHasMermaid "$_mrf_input"
	then
		_mrf_mermaidUrls=$( markshupAssetUrls \
			"$_ms_mermaidJavascriptPaths" "$_mrf_output" )
		_mrf_mermaidUrls=$( markshupAppendValue \
			"$_mrf_mermaidUrls" "$_ms_mermaidJavascriptRefs" )
		_mst_javascriptUrls=$( markshupAppendValue \
			"$_mst_javascriptUrls" "$_mrf_mermaidUrls" )
		_mrf_mermaidJavascriptPath=$_ms_mermaidJavascriptInlinePath
		_mrf_mermaidEnabled=1
	else
		_mrf_mermaidEnabled=0
		_mrf_mermaidJavascriptPath=
	fi
	_mrf_metaPath=$_ms_temporaryDirectory/meta.txt
	_mrf_imageBundlePath=$_ms_temporaryDirectory/image-bundles-render
	printf '%s\n' "$_mst_metaEntries" > "$_mrf_metaPath"
	awk -F '\t' -v source="$_mrf_input" '$1 == source {
		print $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6 "\t" $7
	}' "$_ms_imageBundlePath" > "$_mrf_imageBundlePath"
	mkdir -p "$( dirname "$_mrf_output" )"
	if ! LC_ALL=C awk \
		-v defaultCssPath="$MARKSHUP_DEFAULT_CSS_PATH" \
		-v documentDirectory="${_mrf_output%/*}" \
		-v footerEnabled="$_mst_footerEnabled" \
		-v footerPath="$_mst_footerPath" \
		-v headerEnabled="$_mst_headerEnabled" \
		-v headerPath="$_mst_headerPath" \
		-v imageBundlePath="$_mrf_imageBundlePath" \
		-v outputDirectory="$_ms_outputDirectory" \
		-v pageTitle="$_mrf_title" \
		-v defaultCss="$_ms_defaultCss" \
		-v copyFiles="$_ms_copyFiles" \
		-v faviconUrls="$_mst_faviconUrls" \
		-v faviconLightUrls="$_mst_faviconLightUrls" \
		-v faviconDarkUrls="$_mst_faviconDarkUrls" \
		-v javascriptUrls="$_mst_javascriptUrls" \
		-v mermaidJavascriptPath="$_mrf_mermaidJavascriptPath" \
		-v markdownStyle="$_ms_markdownStyle" \
		-v mermaidEnabled="$_mrf_mermaidEnabled" \
		-v mangleStyle="$_ms_mangleStyle" \
		-v metaPath="$_mrf_metaPath" \
		-v stylesheetUrls="$_mst_stylesheetUrls" \
		-v stripFragmentValue="$_ms_stripFragment" \
		-v sourceDirectory="${_mrf_input%/*}" \
		-v templateLinkMarker="$_ms_templateLinkMarker" \
		-f "$MARKSHUP_RENDERER_PATH" \
		"$_mrf_input" > "$_mrf_temporaryOutput"
	then
		rm -f "$_mrf_temporaryOutput"
		return 1
	fi
	mv "$_mrf_temporaryOutput" "$_mrf_output"
	_mrf_displayInput=$( markshupDisplayPath "$_mrf_input" )
	_mrf_displayOutput=$( markshupDisplayPath "$_mrf_output" )
	printf 'Converted %s to %s\n' \
		"$_mrf_displayInput" "$_mrf_displayOutput"
}


# $1 - Markdown source path.
markshupTitleFromPath( )
{
	_mtfp_path=$1
	_mtfp_name=${_mtfp_path##*/}
	_mtfp_title=$( LC_ALL=C awk '
		inFence {
			if (/^```/) {
				inFence = 0
			}
			next
		}
		/^```/ {
			inFence = 1
			next
		}
		/^#[[:space:]]/ {
			sub(/^#[[:space:]]+/, "")
			print
			exit
		}
		previous !~ /^[[:space:]]*$/ && /^=+[[:space:]]*$/ {
			print previous
			exit
		}
		{
			previous = $0
		}
	' "$_mtfp_path" )
	if [ -n "$_mtfp_title" ]
	then
		printf '%s\n' "$_mtfp_title"
	else
		printf '%s\n' "$_mtfp_name"
	fi
}


# $1 - Markdown source path.
#
# Prints local Markdown paths referenced by the source.
markshupReferencedUrls( )
{
	LC_ALL=C awk '
	function printMarkdownUrl(url) {
		gsub(/^[ \t]+|[ \t]+$/, "", url)
		if (url ~ /^<.*>$/) {
			url = substr(url, 2, length(url) - 2)
		}
		if (url !~ /^[A-Za-z][A-Za-z0-9+.-]*:/ \
			&& url !~ /^\/\// && url !~ /^#/ \
			&& url ~ /\.md([?#].*)?$/) {
			print url
		}
	}
	/^```/ {
		inFence = !inFence
		next
	}
	inFence {
		next
	}
	/^\[[^]]+\]:[ \t]*/ {
		url = $0
		sub(/^\[[^]]+\]:[ \t]*/, "", url)
		sub(/[ \t].*$/, "", url)
		printMarkdownUrl(url)
	}
	{
		line = $0
		while (match(line, /\]\([^)]+\)/)) {
			url = substr(line, RSTART + 2, RLENGTH - 3)
			printMarkdownUrl(url)
			line = substr(line, RSTART + RLENGTH)
		}
	}' "$1"
}


# $1 - Markdown source path.
#
# Prints local non-Markdown file paths referenced by the source.
markshupReferencedAssetUrls( )
{
	LC_ALL=C awk '
	function htmlReferenceUrl(tag, attribute, lowerTag, value) {
		lowerTag = tolower(tag)
		if (!match(lowerTag, "[[:space:]]" attribute \
			"[ \\t]*=[ \\t]*(\\\"[^\\\"]*\\\"|'"'"'[^'"'"']*'"'"'|[^ \\t>]+)")) {
			return ""
		}
		value = substr(tag, RSTART, RLENGTH)
		sub(/^[^=]*=[ \\t]*/, "", value)
		if (value ~ /^\"/) {
			return substr(value, 2, length(value) - 2)
		}
		if (value ~ /^'"'"'/) {
			return substr(value, 2, length(value) - 2)
		}
		return value
	}
	function printHtmlAssetUrls(line, tag, lowerTag, url) {
		while (match(line, /<[[:space:]]*[[:alpha:]][[:alnum:]:-]*[^>]*>/)) {
			tag = substr(line, RSTART, RLENGTH)
			line = substr(line, RSTART + RLENGTH)
			lowerTag = tolower(tag)
			if (lowerTag ~ /^<[[:space:]]*a[[:space:]>]/) {
				url = htmlReferenceUrl(tag, "href")
			} else if (lowerTag ~ \
				/^<[[:space:]]*(iframe|img|source|track)[[:space:]>]/) {
				url = htmlReferenceUrl(tag, "src")
			} else {
				continue
			}
			printAssetUrl(url)
		}
	}
	function printAssetUrl(url) {
		gsub(/^[ \t]+|[ \t]+$/, "", url)
		if (url ~ /^<.*>$/) {
			url = substr(url, 2, length(url) - 2)
		} else {
			sub(/[ \t].*$/, "", url)
		}
		if (url !~ /^[A-Za-z][A-Za-z0-9+.-]*:/ \
			&& url !~ /^\/\// && url !~ /^\// && url !~ /^#/ \
			&& url !~ /\.md([?#].*)?$/) {
			print url
		}
	}
	/^```/ {
		inFence = !inFence
		next
	}
	inFence {
		next
	}
	/^\[[^]]+\]:[ \t]*/ {
		url = $0
		sub(/^\[[^]]+\]:[ \t]*/, "", url)
		sub(/[ \t].*$/, "", url)
		printAssetUrl(url)
	}
	{
		line = $0
		while (match(line, /\]\([^)]+\)/)) {
			url = substr(line, RSTART + 2, RLENGTH - 3)
			printAssetUrl(url)
			line = substr(line, RSTART + RLENGTH)
		}
		printHtmlAssetUrls($0)
	}' "$1"
}


# $1 - Markdown source path.
# $2 - Corresponding HTML output path.
markshupCopyReferencedAssets( )
{
	[ "$_ms_copyFiles" -eq 1 ] || return 0
	_mcra_sourceDirectory=${1%/*}
	_mcra_outputDirectory=${2%/*}
	markshupReferencedAssetUrls "$1" | while IFS= read -r _mcra_url
	do
		_mcra_path=${_mcra_url%%[?#]*}
		_mcra_output=$( markshupAssetOutputPath \
			"$_mcra_outputDirectory" "$_mcra_path" ) \
			|| {
				markshupVerifyExternalAssetReference \
					"$_mcra_outputDirectory" "$_mcra_path"
				continue
			}
		_mcra_source=$( markshupAbsoluteFilePath \
			"$_mcra_sourceDirectory/$_mcra_path" ) || continue
		case $_mcra_source in
			"$_ms_inputRoot"/*) ;;
			*)
				markshupVerifyExternalAssetReference \
					"$_mcra_outputDirectory" "$_mcra_path"
				continue
				;;
		esac
		if grep -F -x "$_mcra_output" "$_ms_assetOutputPaths" \
			> /dev/null 2>&1
		then
			continue
		fi
		printf '%s\n' "$_mcra_output" >> "$_ms_assetOutputPaths"
		markshupCreateAssetDirectory "$_mcra_output"
		cp "$_mcra_source" "$_mcra_output" || markshupFail \
			"Could not copy referenced file: $_mcra_path"
	done
}


# $1 - Markdown source path.
# $2 - Corresponding HTML output path.
markshupCopyImageBundles( )
{
	[ "$_ms_imgEnabled" -eq 1 ] || return 0
	_mcib_sourceDirectory=${1%/*}
	_mcib_outputDirectory=${2%/*}
	markshupReferencedAssetUrls "$1" | while IFS= read -r _mcib_url
	do
		_mcib_url=${_mcib_url%%[[:space:]]*}
		_mcib_path=${_mcib_url%%[?#]*}
		case $_mcib_path in
			*.img/*)
				_mcib_directoryPath=${_mcib_path%%.img/*}.img
				;;
			*) continue ;;
		esac
		if [ "$_ms_copyFiles" -eq 1 ]
		then
			markshupAssetOutputPath "$_mcib_outputDirectory" \
				"$_mcib_path" > /dev/null || continue
		fi
		_mcib_directory=$( markshupAbsoluteDirectoryPath \
			"$_mcib_sourceDirectory/$_mcib_directoryPath" ) || continue
		case $_mcib_directory in
			"$_ms_inputRoot"/*) ;;
			*) continue ;;
		esac
		_mcib_inventory=$_ms_temporaryDirectory/image-bundle-inventory
		: > "$_mcib_inventory"
		_mcib_hasLight=0
		_mcib_hasDark=0
		_mcib_hasImage=0
		_mcib_referenceName=${_mcib_path##*/}
		case $_mcib_referenceName in
			image.*|image@2x.*|image@3x.*) _mcib_fallbackColor=image ;;
			light.*|light@2x.*|light@3x.*) _mcib_fallbackColor=light ;;
			dark.*|dark@2x.*|dark@3x.*) _mcib_fallbackColor=dark ;;
			*) continue ;;
		esac
		find "$_mcib_directory" -maxdepth 1 -type f -print | sort | \
		while IFS= read -r _mcib_image
		do
			_mcib_name=${_mcib_image##*/}
			case $_mcib_name in
				light.*) _mcib_color=light; _mcib_density=1 ;;
				light@2x.*) _mcib_color=light; _mcib_density=2 ;;
				light@3x.*) _mcib_color=light; _mcib_density=3 ;;
				dark.*) _mcib_color=dark; _mcib_density=1 ;;
				dark@2x.*) _mcib_color=dark; _mcib_density=2 ;;
				dark@3x.*) _mcib_color=dark; _mcib_density=3 ;;
				image.*) _mcib_color=image; _mcib_density=1 ;;
				image@2x.*) _mcib_color=image; _mcib_density=2 ;;
				image@3x.*) _mcib_color=image; _mcib_density=3 ;;
				*) continue ;;
			esac
			_mcib_extension=${_mcib_name##*.}
			case $_mcib_extension in
				svg|avif|heic|webp|apng|png|jpg|gif|bmp) ;;
				*) continue ;;
			esac
			printf '%s\t%s\t%s\t%s\n' "$_mcib_color" \
				"$_mcib_extension" "$_mcib_density" "$_mcib_image" \
				>> "$_mcib_inventory"
		done
		grep -F -q 'light	' "$_mcib_inventory" && _mcib_hasLight=1
		grep -F -q 'dark	' "$_mcib_inventory" && _mcib_hasDark=1
		grep -F -q 'image	' "$_mcib_inventory" && _mcib_hasImage=1
		if [ "$_mcib_fallbackColor" = image ]
		then
			[ "$_mcib_hasImage" -eq 1 ] || continue
		elif [ "$_mcib_hasLight" -ne 1 ] || [ "$_mcib_hasDark" -ne 1 ]
		then
			continue
		fi
		while IFS='	' read -r _mcib_color _mcib_extension \
			_mcib_density _mcib_image
		do
			if [ "$_mcib_color" = image ] \
				&& [ "$_mcib_fallbackColor" != image ]
			then
				continue
			fi
			if [ "$_mcib_color" != image ] \
				&& { [ "$_mcib_hasLight" -ne 1 ] \
				|| [ "$_mcib_hasDark" -ne 1 ]; }
			then
				continue
			fi
			_mcib_name=${_mcib_image##*/}
			if [ "$_ms_copyFiles" -eq 1 ]
			then
				_mcib_output=$( markshupAssetOutputPath \
					"$_mcib_outputDirectory" \
					"$_mcib_directoryPath/$_mcib_name" ) \
					|| markshupFail \
					"Referenced file escapes the output directory: " \
					"$_mcib_directoryPath"
				if ! grep -F -x "$_mcib_output" "$_ms_assetOutputPaths" \
					> /dev/null 2>&1
				then
					printf '%s\n' "$_mcib_output" >> "$_ms_assetOutputPaths"
					markshupCreateAssetDirectory "$_mcib_output"
					cp "$_mcib_image" "$_mcib_output" || markshupFail \
						"Could not copy referenced image: " \
						"$_mcib_directoryPath/$_mcib_name"
				fi
			fi
			printf '%s\t%s\t%s\t%s\t%s\t%s\t%s/%s\n' "$1" \
				"$_mcib_url" "$_mcib_directory/alt.txt" "$_mcib_color" \
				"$_mcib_extension" "$_mcib_density" \
				"$_mcib_directoryPath" "$_mcib_name" \
				>> "$_ms_imageBundlePath"
		done < "$_mcib_inventory"
	done
}


# $1 - Absolute Markdown source path.
markshupQueueSource( )
{
	_mqs_source=$1
	case $_mqs_source in
		"$_ms_inputRoot"/*) ;;
		*) markshupFail \
			"Referenced Markdown file is outside the input directory: $_mqs_source" ;;
	esac
	if ! grep -F -x "$_mqs_source" "$_ms_seenPaths" > /dev/null 2>&1
	then
		printf '%s\n' "$_mqs_source" >> "$_ms_seenPaths"
		printf '%s\n' "$_mqs_source" >> "$_ms_queuedPaths"
	fi
}


# $1 - Absolute Markdown source path.
markshupQueueReferences( )
{
	_mqr_sourceDirectory=${1%/*}
	{
		markshupReferencedUrls "$1"
		LC_ALL=C awk '
		function htmlReferenceUrl(tag, attribute, lowerTag, value) {
			lowerTag = tolower(tag)
			if (!match(lowerTag, "[[:space:]]" attribute \
				"[ \\t]*=[ \\t]*" \
				"(\\\"[^\\\"]*\\\"|'"'"'[^'"'"']*'"'"'|[^ \\t>]+)")) {
				return ""
			}
			value = substr(tag, RSTART, RLENGTH)
			sub(/^[^=]*=[ \\t]*/, "", value)
			if (value ~ /^\"|^'"'"'/) {
				return substr(value, 2, length(value) - 2)
			}
			return value
		}
		{
			line = $0
			while (match(line, /<[[:space:]]*[[:alpha:]][[:alnum:]:-]*[^>]*>/)) {
				tagStart = RSTART
				tagLength = RLENGTH
				tag = substr(line, tagStart, tagLength)
				lowerTag = tolower(tag)
				if (lowerTag ~ /^<[[:space:]]*a[[:space:]>]/) {
					attribute = "href"
				} else if (lowerTag ~ \
					/^<[[:space:]]*(iframe|img|source|track)[[:space:]>]/) {
					attribute = "src"
				} else {
					line = substr(line, tagStart + tagLength)
					continue
				}
				url = htmlReferenceUrl(tag, attribute)
				if (url ~ /^[A-Za-z][A-Za-z0-9+.-]*:/ \
					|| url ~ /^\/\// || url ~ /^#/) {
					line = substr(line, tagStart + tagLength)
					continue
				}
				if (url ~ /\.md([?#].*)?$/) {
					print url
				}
				line = substr(line, tagStart + tagLength)
			}
		}' "$1"
	} | while IFS= read -r _mqr_url
	do
		_mqr_path=${_mqr_url%%[?#]*}
		_mqr_target=$( markshupAbsoluteFilePath \
			"$_mqr_sourceDirectory/$_mqr_path" ) \
			|| markshupFail "Referenced Markdown file not found: $_mqr_path"
		markshupQueueSource "$_mqr_target"
	done
}


# $@ - Initial absolute Markdown source paths.
markshupConvert( )
{
	_ms_seenPaths=$_ms_temporaryDirectory/seen
	_ms_queuedPaths=$_ms_temporaryDirectory/queue
	_ms_outputPaths=$_ms_temporaryDirectory/outputs
	_ms_assetOutputPaths=$_ms_temporaryDirectory/asset-outputs
	_ms_imageBundlePath=$_ms_temporaryDirectory/image-bundles
	_ms_brokenReferencePaths=$_ms_temporaryDirectory/broken-references
	: > "$_ms_seenPaths"
	: > "$_ms_queuedPaths"
	: > "$_ms_outputPaths"
	: > "$_ms_assetOutputPaths"
	: > "$_ms_imageBundlePath"
	: > "$_ms_brokenReferencePaths"
	for _mc_source
	do
		markshupQueueSource "$_mc_source"
	done

	while IFS= read -r _mc_source
	do
		markshupQueueReferences "$_mc_source"
	done < "$_ms_queuedPaths"

	_ms_mermaidEnabled=0
	while IFS= read -r _mc_source
	do
		if markshupSourceHasMermaid "$_mc_source"
		then
			_ms_mermaidEnabled=1
			break
		fi
	done < "$_ms_queuedPaths"
	if [ "$_ms_mermaidEnabled" -eq 1 ]
	then
		_ms_mermaidJavascriptPaths=
		_ms_mermaidJavascriptRefs=
		_ms_mermaidJavascriptInlinePath=
		markshupPrepareMermaidHelper
	fi

	while IFS= read -r _mc_source
	do
		markshupApplyTemplateOverridesForSource "$_mc_source"
		_mc_output=$( markshupOutputPath "$_mc_source" )
		markshupCopyReferencedAssets "$_mc_source" "$_mc_output"
		markshupCopyImageBundles "$_mc_source" "$_mc_output"
	done < "$_ms_queuedPaths"

	while IFS= read -r _mc_source
	do
		markshupApplyTemplateOverridesForSource "$_mc_source"
		_mc_output=$( markshupOutputPath "$_mc_source" )
		if grep -F -x "$_mc_output" "$_ms_outputPaths" > /dev/null 2>&1
		then
			markshupFail \
				"Multiple Markdown files use output path: $_mc_output"
		fi
		printf '%s\n' "$_mc_output" >> "$_ms_outputPaths"
		_mc_title=$( markshupTitleFromPath "$_mc_source" )
		if [ -n "$_ms_title" ]
		then
			_mc_title=$_ms_title': '$_mc_title
		fi
		markshupRenderFile "$_mc_source" "$_mc_output" "$_mc_title"
	done < "$_ms_queuedPaths"
	markshupReportBrokenReferences
}


# $1 - Absolute source directory path.
markshupConvertDirectory( )
{
	_mcd_paths=$_ms_temporaryDirectory/directory-paths
	if [ "$_ms_recursive" -eq 1 ]
	then
		find "$1" -type f -name '*.md' -print | sort > "$_mcd_paths"
	else
		: > "$_mcd_paths"
		for _mcd_path in "$1"/*.md
		do
			[ -f "$_mcd_path" ] || continue
			printf '%s\n' "$_mcd_path" >> "$_mcd_paths"
		done
	fi
	# Positional arguments preserve paths containing spaces.
	set --
	while IFS= read -r _mcd_path
	do
		set -- "$@" "$_mcd_path"
	done < "$_mcd_paths"
	markshupConvert "$@"
}

