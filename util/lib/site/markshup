}


# $1 - URL.
# $2 - Output path.
markshupDownload( )
{
	if command -v curl > /dev/null 2>&1
	then
		curl -fsSL --output "$2" "$1"
		return
	fi
	if command -v wget > /dev/null 2>&1
	then
