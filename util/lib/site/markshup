# $1 - Template file path.
#
# Sets _mtm_marker to the first non-blank, non-comment line when it is a
# template marker. Fails for invalid marker syntax.
markshupTemplateMarker( )
{
	_mtm_marker=
	while IFS= read -r _mtm_line || [ -n "$_mtm_line" ]
	do
		_mtm_line=$( printf '%s\n' "$_mtm_line" | sed \
			's/^[[:space:]]*//; s/[[:space:]]*$//' )
		[ -n "$_mtm_line" ] || continue
		case $_mtm_line in
			\#*) continue ;;
		esac
		case $_mtm_line in
			--|+|--+) _mtm_marker=$_mtm_line ;;
			+--|'-- +')
				markshupFail \
					"Invalid template marker in $1: $_mtm_line"
				;;
		esac
		return 0
	done < "$1"
}


